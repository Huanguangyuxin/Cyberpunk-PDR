{
  "name": "@local/afterlife-engine",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "packageManager": "pnpm@12.10.1",
  "scripts": {
    "dev": "node scripts/forgeax-native.mjs dev start",
    "build": "node scripts/forgeax-native.mjs project build",
    "package": "node scripts/forgeax-native.mjs project package",
    "serve": "node scripts/forgeax-native.mjs project preview",
    "preview": "node scripts/forgeax-native.mjs project preview",
    "doctor": "forgeax project check",
    "test": "forgeax project test",
    "typecheck": "pnpm exec tsc --noEmit"
  },
  "forgeax": {
    "startupTimeoutMs": 120000,
    "frameTimeoutMs": 20000,
    "metrics": {
      "bundle-size": {
        "enabled": false,
        "reason": "template bundle is downstream of the SDK verifier host"
      },
      "fps": {
        "enabled": false,
        "reason": "template has no independent benchmark harness"
      },
      "bench": {
        "enabled": false,
        "reason": "template scaffold; benchmark ownership stays with engine apps"
      },
      "gate": {
        "enabled": false,
        "reason": "browser acceptance is owned by the exact SDK verifier"
      },
      "spike-report": {
        "enabled": false,
        "reason": "not a spike app"
      }
    }
  },
  "dependencies": {
    "@forgeax/engine": "0.5.0"
  },
  "devDependencies": {
    "@types/node": "20.19.40",
    "@webgpu/types": "0.1.71",
    "tsx": "4.23.1",
    "typescript": "6.0.3",
    "vitest": "4.0.18"
  }
}
